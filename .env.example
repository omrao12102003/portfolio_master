# Portfolio Master environment template
#
# Copy this file to ".env" in the repository root:
#   cp .env.example .env
#
# .env is gitignored. Do not commit secrets.
# Stage 1A does not use vendor API keys. Do not add fake keys.

# -----------------------------------------------------------------------------
# Application (optional; defaults exist in backend Settings)
# -----------------------------------------------------------------------------
APP_NAME=Portfolio Master
APP_ENVIRONMENT=development

# Bind address for uvicorn when not using Docker. Optional.
API_HOST=0.0.0.0
API_PORT=8000

# -----------------------------------------------------------------------------
# PostgreSQL + pgvector (required to start Docker Compose database)
# Development credentials only. Change these before any shared or deployed use.
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=portfolio_master
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio

# -----------------------------------------------------------------------------
# Database URL (optional until Stage 2+ persistence)
# Host "localhost" is for processes on the Mac.
# Inside Compose, the API service overrides this to host "postgres".
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio_master
